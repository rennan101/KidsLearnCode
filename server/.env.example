# KidsLearnCode Servidor Dedicado - Configuração de Ambiente
# Copie para .env no servidor Mac mini

# 1. Configurações de Rede e Servidor
PORT=8080
NODE_ENV=production
PUBLIC_URL=http://localhost:8080
# Se usar Cloudflare Tunnel, defina a URL pública (ex: https://mmo.seusite.com):
# PUBLIC_URL=https://mmo.seusite.com

# 2. Banco de Dados PostgreSQL Local
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=kidslearncode
DB_USER=kidsadmin
DB_PASSWORD=kidslearn_seguro_local
# Caminho de dados no SSD Externo (ex: /Volumes/SSD FN501 PRO/pgdata)
PGDATA_DIR=/Volumes/SSD FN501 PRO/pgdata

# 3. Autenticação & JWT
JWT_SECRET=kidslearn_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# 4. E-mail SMTP Próprio (Gratuito)
# Pode usar Gmail (com Senha de Aplicativo), Outlook, Zoho, etc.
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app-16-digitos
SMTP_FROM="Ilha Lua - KidsLearnCode" <seu-email@gmail.com>

# 5. Painel Administrativo GUI
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin_seguro_2026
