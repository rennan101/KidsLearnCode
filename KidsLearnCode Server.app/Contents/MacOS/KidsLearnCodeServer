#!/bin/bash
# =============================================================================
# KidsLearnCode Server.app — Inicializador 1-Clique (Local & Remoto)
# - Detecta dinamicamente o diretório no SSD
# - Auto-repara server/node_modules caso express esteja ausente
# - Blindagem 5: Inicia com caffeinate -dimsu para nunca suspender o Mac
# - Se aberto em outro Mac sem a pasta server/, abre o Painel Remoto integrado
# =============================================================================

export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

MACOS_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
CONTENTS_DIR="$( cd "$MACOS_DIR/.." && pwd )"
APP_BUNDLE_DIR="$( cd "$CONTENTS_DIR/.." && pwd )"
PROJECT_DIR="$( cd "$APP_BUNDLE_DIR/.." && pwd )"

NODE_BIN="$(command -v node || echo '/opt/homebrew/bin/node')"
NPM_BIN="$(command -v npm || echo '/opt/homebrew/bin/npm')"

if [ -f "$PROJECT_DIR/server/index.js" ]; then
  cd "$PROJECT_DIR"

  # Auto-reparo: garante que express e dependências estão instaladas em server/node_modules
  if [ ! -d "$PROJECT_DIR/server/node_modules/express" ]; then
    "$NPM_BIN" --prefix "$PROJECT_DIR/server" install --no-audit --no-fund >> "$PROJECT_DIR/server/server.log" 2>&1
  fi

  # Inicia o servidor Node.js na porta 8080 se não estiver rodando
  if ! lsof -i :8080 >/dev/null 2>&1; then
    cd "$PROJECT_DIR/server"
    nohup /usr/bin/caffeinate -dimsu "$NODE_BIN" "$PROJECT_DIR/server/index.js" >> "$PROJECT_DIR/server/server.log" 2>&1 &
    for _ in 1 2 3 4 5 6; do
      if lsof -i :8080 >/dev/null 2>&1; then
        break
      fi
      sleep 0.5
    done
  fi

  if lsof -i :8080 >/dev/null 2>&1; then
    open "http://localhost:8080/admin"
  elif [ -f "$PROJECT_DIR/Painel-Servidor-KidsLearnCode.html" ]; then
    open "$PROJECT_DIR/Painel-Servidor-KidsLearnCode.html"
  fi
else
  # Estamos em outro computador usando apenas o .app portátil como Controle Remoto
  EMBEDDED_HTML="$CONTENTS_DIR/Resources/Painel-Servidor-KidsLearnCode.html"
  if [ -f "$EMBEDDED_HTML" ]; then
    open "$EMBEDDED_HTML"
  fi
fi
